# Godot 4 editor cache (regenerated by `godot --import`)
.godot/
*.tmp

# Goo2D's native kernel: cargo's output. The built libraries in addons/goo2d/bin/
# ARE committed (.github/workflows/kernel.yml builds every platform and commits them
# back); tools/build_native.sh rebuilds this machine's.
addons/goo2d/native/target/

# Keep *.import and *.uid sidecar files committed: Godot needs them to resolve
# resources and script references consistently across machines.

# Exported builds
/build/
/export/

# Test output
junit.xml

# OS / tooling
.DS_Store
Thumbs.db
__pycache__/

# Claude Code agent worktrees
.claude/worktrees/

# Godot on Windows runs a GDExtension from a temporary copy named ~<library>
~*.dll
